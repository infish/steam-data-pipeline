MYSQL_DATABASE=steam_pipeline
MYSQL_ROOT_PASSWORD=password

PIPELINE_DB_USER=steam_pipeline
PIPELINE_DB_PASSWORD=password

DASHBOARD_DB_USER=steam_dashboard
DASHBOARD_DB_PASSWORD=password

WRITER_DB_USER=steam_writer
WRITER_DB_PASSWORD=password

STEAMSPY_MODE=all
STEAMSPY_PAGE=0
# SteamSpy pages of 1,000 games each, from STEAMSPY_PAGE on (ADR 6).
STEAMSPY_PAGES=5
STEAM_TRACKED_APPIDS=730,427520,620
PIPELINE_MAX_REJECTED_PERCENT=5
RAW_RETENTION_DAYS=30
PLAYER_HOURLY_RETENTION_DAYS=90
# refresh_hourly: every game's Store details every DETAILS_REFRESH_DAYS and
# its review summary every REVIEWS_REFRESH_DAYS (0 = off), within
# REFRESH_MAX_REQUESTS Store requests per hourly run (ADR 6).
DETAILS_REFRESH_DAYS=7
REVIEWS_REFRESH_DAYS=1
REFRESH_MAX_REQUESTS=300
# Optional fixed counts per refresh run instead of the derived ones.
STORE_DETAILS_PER_RUN=
REVIEW_SUMMARIES_PER_RUN=
# Days before a game's SteamSpy tags are fetched again (0 = every refresh).
TAG_REFRESH_DAYS=30
# Games seen in Valve's top-100 or most-played charts join the catalog.
CATALOG_FROM_VALVE_CHARTS=true
# Days between SteamSpy page fetches (SteamSpy is frozen; 1 = every run).
STEAMSPY_PAGE_INTERVAL_DAYS=7
STEAM_STORE_COUNTRY=us

PIPELINE_TIMEZONE=Europe/Prague
JOB_PLAYERS_MINUTE=7
JOB_REFRESH_MINUTE=37
JOB_CATALOG_TIME=20:00
JOB_REVIEWS_TIME=20:30
PIPELINE_RUN_ON_STARTUP=false
